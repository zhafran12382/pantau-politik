{
  "name": "platform-politik-interaktif-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform Politik Interaktif MVP — situs statis Astro (Pantau isu + Pembanding indikator)",
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "serve": "node ./scripts/serve.mjs",
    "check": "astro check && tsc --noEmit",
    "validate:content": "node ./scripts/validate-content.mjs",
    "validate:data": "node ./scripts/validate-data.mjs",
    "validate": "node ./scripts/validate-content.mjs && node ./scripts/validate-data.mjs",
    "test": "node --test tests/unit/*.mjs",
    "test:integration": "node --test tests/integration/*.mjs",
    "build:editorial": "node ./scripts/build-editorial.mjs",
    "build": "npm run validate && astro build",
    "build:candidate": "BUILD_CANDIDATE=1 npm run build && DIST_DIR=dist-candidate node scripts/generate-sitemap.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "sync:workspace": "node scripts/sync-workspace.mjs",
    "test:artifacts": "node ./scripts/test-artifacts.mjs",
    "test:e2e": "node ./scripts/test-e2e.mjs",
    "audit:bundle": "node ./scripts/audit-bundle.mjs",
    "release:check": "node ./scripts/release-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "axe-core": "4.13.0",
    "fontkit": "2.0.4",
    "jsdom": "30.1.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
