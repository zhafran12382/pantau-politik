---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class="brand-mark" aria-hidden={!compact}>
  {compact
    ? <><span class="file-code" aria-hidden="true">PP</span><span class="sr-only">Pantau Politik</span></>
    : <span class="brand-mark__word">Pantau <em>Politik</em></span>}
</span>
