---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class="brand-mark" aria-hidden={!compact}>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="2" y="2" width="28" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
    <path d="M8 12h16M8 17.5h10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    <rect x="19.5" y="19.5" width="6" height="6" fill="var(--color-accent)" stroke="none"/>
  </svg>
  {compact
    ? <span class="sr-only">Pantau Politik</span>
    : <span class="brand-mark__word">Pantau <em>Politik</em></span>}
</span>
