---
import { isStale, todayJakartaISO, formatTanggalID, relativeID } from '../../lib/dates/dates.mjs';
interface Props { date: string; kind?: string }
const { date, kind = 'Pemeriksaan editorial dan sumber' } = Astro.props;
const today = todayJakartaISO();
const stale = isStale(date, today);
const relative = relativeID(date, today) || '';
---
<p class:list={['meta', { 'freshness--stale': stale }]} title={`${kind}: ${formatTanggalID(date)}`}>{stale ? 'Belum diperiksa ulang sejak' : 'Diperiksa'} {relative} · <time datetime={date}>{formatTanggalID(date)}</time></p>
