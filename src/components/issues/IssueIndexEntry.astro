---
import StatusChip from '../shared/StatusChip.astro';
import type issues from '../../../content/issues/issues.json';
interface Props { issue: (typeof issues)[number]; code: string; sourceCount: number; }
const { issue, code, sourceCount } = Astro.props;
const href = `/isu/${issue.slug}/`;
---
<li class="register-entry" data-issue-id={issue.id} data-category={issue.category} data-search={`${code} ${issue.title} ${issue.card_summary} ${issue.category}`.toLowerCase()}>
  <span class="register-entry__code file-code">{code}</span>
  <div class="register-entry__body">
    <p class="meta">{issue.category}</p>
    <h3><a href={href}>{issue.title}</a></h3>
  </div>
  <div class="register-entry__meta">
    <StatusChip status={issue.status} />
    <a class="text-link" href={`${href}#sumber`}>{sourceCount} sumber<span class="sr-only">: {issue.title}</span></a>
  </div>
</li>
