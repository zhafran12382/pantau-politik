---
import StatusChip from '../shared/StatusChip.astro';
import Freshness from '../shared/Freshness.astro';
import type issues from '../../../content/issues/issues.json';
interface Props {
  issue: (typeof issues)[number];
  code: string;
  sourceCount: number;
  featured?: boolean;
}
const { issue, code, sourceCount, featured = false } = Astro.props;
const href = `/isu/${issue.slug}/`;
---
<article class:list={['issue-card', 'clipping', { 'issue-card--featured': featured, 'dossier-frame': featured }]} data-issue-id={issue.id} data-category={issue.category} data-search={`${code} ${issue.title} ${issue.card_summary} ${issue.category}`.toLowerCase()}>
  {featured && <div class="filing-tab"><span class="file-code">BERKAS {code}</span></div>}
  <div class="issue-card__top clipping__filehead filehead">
    {!featured && <span class="register-id file-code">{code}</span>}
    <span class="issue-card__category">{issue.category}</span>
  </div>
  <h3>{featured ? issue.title : <a class="issue-title-link" href={href}>{issue.title}</a>}</h3>
  <p class="issue-card__summary">{issue.card_summary}</p>
  <div class="status-line"><StatusChip status={issue.status} /></div>
  <div class="clipping__foot">
    <span class="meta"><span class="file-code">Jejak bukti</span> · {sourceCount} sumber</span>
    {featured && <Freshness date={issue.last_checked_at} />}
    <div class="actions">
      {featured && <a class="button issue-card__cta" href={href}>Baca penjelasan</a>}
      <a class="text-link" href={`${href}#sumber`}>Buka sumber<span class="sr-only">: {issue.title}</span></a>
    </div>
  </div>
</article>
