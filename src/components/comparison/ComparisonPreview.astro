---
import { comparisonPreviewView } from '../../lib/comparison/view.mjs';
import type { comparisonFor } from '../../lib/comparison/compute.mjs';
import indicators from '../../../content/indicators/indicators.json';
import sources from '../../../content/sources/sources.json';
interface Props { comparison: ReturnType<typeof comparisonFor>; indicator: (typeof indicators)[number]; }
const { comparison, indicator } = Astro.props;
const view = comparisonPreviewView(comparison, indicator);
const publishers = [...new Set(indicator.source_ids.map(id => sources.find(source => source.id === id)?.publisher).filter(Boolean))];
const href = `/bandingkan/?a=${comparison.admA.id}&b=${comparison.admB.id}&indikator=${indicator.id}&mode=kalender`;
---
<figure class="preview-chart exhibit dossier-frame">
  <figcaption class="exhibit__filehead filehead">
    <span class="filing-tab">EXHIBIT DATA</span>
    <span class="file-code">Indikator / {indicator.id}</span>
  </figcaption>
  <div class="exhibit__body">
    <p>{indicator.label}</p>
    <p><span class="stamp stamp--soft" role="note">DRAF PRATINJAU — BELUM AUDIT</span></p>
    <p class="meta">Angka pratinjau belum menyelesaikan audit editorial terhadap dokumen sumber.</p>
    {view.numbers && <div class="preview-numbers" set:html={view.numbers} />}
    {view.numbers && !comparison.crossCompatible && <p class="notice notice--warning">Versi seri tidak kompatibel. Statistik yang tersedia hanya berlaku dalam periodenya, bukan selisih lintas periode.</p>}
    <div class="chart-shell"><div class="chart-plot" tabindex="0" role="region" aria-label="Grafik pratinjau; tabel tersedia pada halaman pembanding" set:html={view.chart} /></div>
    <p class="meta">{publishers.length ? `Sumber: ${publishers.join('; ')}.` : 'Rujukan tersedia pada pembanding.'}</p>
    <p class="caution-line">Angka menggambarkan kondisi selama periode, bukan bukti sebab-akibat.</p>
  </div>
</figure>
<p><a class="button" href={href}>Buka pembanding</a></p>
