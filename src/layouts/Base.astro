---
import '../styles/global.css';
import BrandMark from '../components/shared/BrandMark.astro';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url';
interface Props { title: string; description: string; canonicalPath: string; noindex?: boolean; }
const { title, description, canonicalPath, noindex = false } = Astro.props;
const preview = !import.meta.env.PUBLIC_SITE_URL;
const canonical = new URL(canonicalPath, Astro.site || 'http://127.0.0.1:4321');
const path = Astro.url.pathname;
const comparing = path.startsWith('/bandingkan/') || path.startsWith('/indikator/');
const reading = path === '/' || path.startsWith('/isu/');
const onMethod = path.startsWith('/metode/');
const editionDate = new Date().toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'long', year: 'numeric' });
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Pantau Politik</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={path.startsWith('/isu/') ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta name="theme-color" content="#f3ecdc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <a class="skip" href="#konten">Lewati ke konten</a>
    <header class="site-header">
      <div class="archive-strip" role="note" aria-label="Status arsip"><div class="container"><span>Arsip publik</span><span>Draf pratinjau — belum audit editorial</span></div></div>
      <div class="container header-inner">
        <div class="masthead-row masthead-nameplate">
          <a class="brand" href="/" aria-label="Pantau Politik — beranda"><BrandMark /></a>
        </div>
        <div class="dateline-row dateline">
          <span class="file-code">Berkas PP-Arsip · Edisi pratinjau</span>
          <span>Jakarta · {editionDate}</span>
          <span>Tanpa akun · Tanpa tebakan</span>
        </div>
        <nav class="site-nav" aria-label="Seksi utama">
          <a href="/" aria-current={reading ? 'page' : undefined}>Pantau</a>
          <a href="/bandingkan/" aria-current={comparing ? 'page' : undefined}>Bandingkan</a>
          <a href="/metode/" aria-current={onMethod ? 'page' : undefined}>Metode</a>
        </nav>
      </div>
    </header>
    <main id="konten" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-about">
          <p class="colophon">Pantau Politik</p>
          <p class="meta">Memahami isu, mengikuti konteks, dan membaca data beserta sumbernya.</p>
          <p class="meta footer-dateline"><span class="file-code">Kolofon arsip</span> · Diterbitkan sebagai arsip publik pratinjau.</p>
        </div>
        <nav class="footer-links" aria-label="Informasi pengelola">
          <a href="/metode/">Metode</a><a href="/tentang/">Tentang</a>
          <a href="/editorial/">Editorial</a><a href="/koreksi/">Koreksi</a><a href="/privasi/">Privasi</a>
        </nav>
        <p class="footer-note footer-note--strong">Pratinjau pengembangan: materi dan dataset awal masih memerlukan audit editorial sebelum dapat dijadikan rujukan. Identitas pengelola dan kontak koreksi belum ditetapkan.</p>
      </div>
    </footer>
  </body>
</html>
