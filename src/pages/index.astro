---
import Base from '../layouts/Base.astro';
import IssueRegisterEntry from '../components/issues/IssueRegisterEntry.astro';
import UpdateLedger from '../components/issues/UpdateLedger.astro';
import ComparisonPreview from '../components/comparison/ComparisonPreview.astro';
import registerMap from '../../content/register-map.json';
import issues from '../../content/issues/issues.json';
import order from '../../content/editorial-order.json';
import indicators from '../../content/indicators/indicators.json';
import observations from '../../content/observations/observations.json';
import sources from '../../content/sources/sources.json';
import corrections from '../../content/corrections/corrections.json';
import events from '../../content/events/events.json';
import { relativeID, todayJakartaISO } from '../lib/dates/dates.mjs';
import { formatID } from '../lib/statistics/stats.mjs';
import { comparisonFor, chartSVG } from '../lib/comparison/compute.mjs';
import { summarizeSeries } from '../lib/statistics/stats.mjs';
import { usedSourceIds, primarySourceCount } from '../lib/content/counts.mjs';

const today = todayJakartaISO();
const published = issues.filter(issue => issue.publication_status === 'published');
const active = order.active_issue_ids.flatMap(id => {
  const issue = published.find(item => item.id === id && item.status !== 'diarsipkan');
  return issue ? [issue] : [];
}).slice(0, 3);
const featured = active.find(issue => issue.id === order.featured_issue_id) || active[0];
const others = active.filter(issue => issue.id !== featured?.id);
const categories = [...new Set(active.map(issue => issue.category))];
const updates = [...active].sort((a, b) => b.updated_at.localeCompare(a.updated_at)).slice(0, Math.min(order.max_updates, 5));

function issueFigure(issue: (typeof issues)[number]) {
  const indicator = indicators.find(item => issue.related_indicator_ids.includes(item.id));
  if (!indicator) return null;
  const points = observations
    .filter(o => o.indicator_id === indicator.id && typeof o.value === 'number')
    .sort((a, b) => a.period_start.localeCompare(b.period_start));
  if (!points.length) return null;
  const values = points.map(p => p.value as number);
  const min = Math.min(...values), max = Math.max(...values), span = max - min || 1;
  const path = values.map((v, i) => `${(i / Math.max(1, values.length - 1) * 112 + 4).toFixed(1)},${(36 - (v - min) / span * 28).toFixed(1)}`).join(' ');
  const first = points[0], last = points.at(-1)!;
  const source = sources.find(s => s.id === last.source_id);
  const unitSuffix = indicator.unit === '%' ? ' %' : '';
  return {
    indicator,
    firstYear: first.period_start.slice(0, 4),
    lastYear: last.period_start.slice(0, 4),
    lastValue: last.value as number,
    rangeLabel: `${formatID(min, indicator.display_precision)}–${formatID(max, indicator.display_precision)}${unitSuffix}`,
    path, source: source?.publisher || '',
  };
}
const figures = new Map(active.map(issue => [issue.id, issueFigure(issue)]));
const usedIds = usedSourceIds(published, events as any[]);
const primarySources = primarySourceCount(sources as any[], usedIds);
const lastUpdate = [...active].sort((a, b) => b.updated_at.localeCompare(a.updated_at))[0];
// Pratinjau memakai model grafik yang sama dengan pembanding (domain dari observasi).
import administrations from '../../content/administrations/administrations.json';
const previewIndicator = indicators.find(i => i.id === 'pdb-growth')!;
const previewComp = comparisonFor(previewIndicator as any, administrations as any, observations as any, 'admin-2004-2014', 'admin-2014-2024');
const anchorYears = [...previewComp.yearsA, ...previewComp.yearsB];
const anchorByYear = new Map(observations.filter(o => o.indicator_id === 'pdb-growth').map(o => [Number(o.period_start.slice(0, 4)), o.value]));
const anchorSum = summarizeSeries(anchorYears, anchorByYear as any, 'mean');
const previewAnchorChart = chartSVG({
  yearsA: anchorYears, sumA: anchorSum, yearsB: [], sumB: { values: [] },
  unit: previewIndicator.unit, idA: 'Pertumbuhan PDB riil 2005–2023', idB: '',
  mode: 'kalender', precision: previewIndicator.display_precision, chartId: 'anchor', width: 360,
  gapYears: [2014], markers: [], footer: 'Sumber: BPS',
});
---
<Base title="Pahami isu. Periksa buktinya." description="Penjelasan isu politik Indonesia, kronologi, sumber, dan pembanding indikator nasional." canonicalPath="/">
  <header class="home-intro">
    <div class="frontpage-kicker">
      <span class="eyebrow">Halaman depan · Arsip publik</span>
      <span class="stamp" role="note">Draf pratinjau — belum audit</span>
    </div>
    <h1>Pahami isu.<br />Periksa buktinya.</h1>
    <p class="lead">Lebih dari membaca berita: konteks isu, kronologi bersumber, dan data pembanding — tanpa akun, tanpa tebakan.</p>
    <hr class="frontpage-rule" aria-hidden="true" /><hr class="frontpage-rule" aria-hidden="true" />
    <div class="hero-grid">
    <div>
    <p class="dateline"><span class="file-code">Berkas PP-REG/001–003</span><span>{active.length} isu terbuka dalam arsip</span></p>
    <ul class="activity-strip" aria-label="Isi berkas">
      <li><strong class="numeric">{active.length}</strong><span>isu aktif</span></li>
      <li><strong class="numeric">{primarySources}</strong><span>sumber primer</span></li>
      <li><strong class="numeric">{indicators.length}</strong><span>indikator nasional</span></li>
      <li><strong>{lastUpdate ? (relativeID(lastUpdate.updated_at, today) || '') : '—'}</strong><span>pembaruan terakhir</span></li>
    </ul>
    <div class="actions" role="navigation" aria-label="Jalur cepat">
      <a class="button" href="#isu">Jelajahi isu</a>
      <a class="button button--secondary" href="/bandingkan/">Bandingkan data</a>
      <a class="text-link" href="/metode/">Cara kami memeriksa →</a>
    </div>
    </div>
    <figure class="hero-anchor">
      <figcaption><span class="file-code">Dokumen PDB-2005/2023</span> · Pertumbuhan PDB riil, 2005–2023 <span>· BPS</span></figcaption>
      <span set:html={previewAnchorChart} />
      <a class="text-link" href="/bandingkan/?a=admin-2004-2014&b=admin-2014-2024&indikator=pdb-growth&mode=kalender">Bandingkan periode →</a>
    </figure>
    </div>
    <dl class="trust-strip">
      <div><dt><strong>Sumber primer di dekat klaim</strong></dt><dd>Setiap pernyataan penting menautkan dokumen pendukungnya.</dd></div>
      <div><dt><strong>Metode terbuka</strong></dt><dd>Definisi indikator, rentang tahun, dan cara hitung tertulis.</dd></div>
      <div><dt><strong>Koreksi tercatat</strong></dt><dd>Perubahan substantif dicatat, bukan diperbaiki diam-diam.</dd></div>
    </dl>
  </header>

  <section aria-labelledby="isu">
    <div class="register-head">
      <h2 id="isu">Register isu</h2>
      <p class="meta" id="resultCount" role="status">{active.length} isu · {categories.length} topik</p>
    </div>
    <hr class="register-rule" aria-hidden="true" /><hr class="register-rule" aria-hidden="true" />
    <div class="search-row">
      <div class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <label class="sr-only" for="issueSearch">Cari nomor, isu, atau topik</label>
        <input id="issueSearch" type="search" name="cari" placeholder="Cari nomor (PP-001), isu, atau topik…" autocomplete="off" />
      </div>
      <ul class="filter-chips" id="categoryFilters" aria-label="Saring menurut topik">
        <li><button type="button" data-category="" aria-pressed="true">Semua</button></li>
        {categories.map(category => <li><button type="button" data-category={category} aria-pressed="false">{category}</button></li>)}
      </ul>
      <p><button type="button" class="button--text" id="resetFilter" hidden>Atur ulang filter</button></p>
    </div>
    {featured ? <div class="issue-grid" id="issueGrid">
      {[featured, ...others].map((issue, index) => {
        const sourceCount = new Set([...issue.source_ids, ...issue.impact.flatMap(impact => impact.source_ids)]).size;
        return <IssueRegisterEntry issue={issue} code={(registerMap as unknown as Record<string, string>)[issue.id] || 'PP-???'} figure={figures.get(issue.id)} sourceCount={sourceCount} featured={index === 0} />;
      })}
      <p class="meta" id="noResults" hidden>Tidak ada isu yang cocok. Coba kata kunci atau topik lain.</p>
    </div> : <section class="section-block"><h2>Belum ada isu yang diterbitkan</h2><p>Penjelasan akan muncul setelah pemeriksaan editorial. <a href="/editorial/">Baca proses editorial.</a></p></section>}
    <details class="mode-help"><summary>Apa arti status isu?</summary><p>Status menjelaskan proses informasi/kebijakan, bukan opini situs: <strong>sedang berkembang</strong> masih berubah dan diperiksa berkala; <strong>menunggu keputusan</strong> menunggu lembaga berwenang; <strong>diterapkan</strong> kebijakan/metode sudah berjalan (bukan penilaian berhasil).</p></details>
  </section>

  <UpdateLedger items={
    [...corrections.filter(c => c.affected_ids.some(id => active.some(a => a.id === id))).map(c => {
        const issue = active.find(a => a.id === c.affected_ids[0]);
        return { kind: 'Koreksi', date: c.corrected_at, title: c.change_summary, href: issue ? `/isu/${issue.slug}/#koreksi` : '/koreksi/', detail: `Alasan: ${c.reason}.` };
      }),
      ...updates.map(issue => ({ kind: 'Penjelasan', date: issue.updated_at, title: issue.title, href: `/isu/${issue.slug}/`, detail: `Status: ${issue.status}.` }))]
      .sort((a, b) => b.date.localeCompare(a.date))
  } />

  <section class="section-block comparison-invitation" aria-labelledby="bandingkan-heading">
    <div><p class="eyebrow">Exhibit data · Pembanding</p><h2 id="bandingkan-heading">Satu indikator, dua periode.</h2>
      <ComparisonPreview comparison={previewComp} indicator={previewIndicator} />
      <p>Lima indikator nasional 2005–2013 lawan 2015–2023: grafik, tabel, sumber, dan metode dalam satu layar.</p>
      <a class="text-link" href="/metode/">Bagaimana perbandingan dihitung →</a>
    </div>
    <a class="button" href="/bandingkan/">Buka pembanding <span aria-hidden="true">→</span></a>
  </section>
</Base>
<script>
  import { initIssueFilter } from '../client/home-filter.mjs';
  initIssueFilter(document, window);
</script>
