---
import Base from '../layouts/Base.astro';
import IssueRegisterEntry from '../components/issues/IssueRegisterEntry.astro';
import IssueIndexEntry from '../components/issues/IssueIndexEntry.astro';
import UpdateLedger from '../components/issues/UpdateLedger.astro';
import ComparisonPreview from '../components/comparison/ComparisonPreview.astro';
import registerMap from '../../content/register-map.json';
import issues from '../../content/issues/issues.json';
import order from '../../content/editorial-order.json';
import indicators from '../../content/indicators/indicators.json';
import observations from '../../content/observations/observations.json';
import corrections from '../../content/corrections/corrections.json';
import events from '../../content/events/events.json';
import administrations from '../../content/administrations/administrations.json';
import { comparisonFor } from '../lib/comparison/compute.mjs';

const published = issues.filter(issue => issue.publication_status === 'published');
const active = order.active_issue_ids.flatMap(id => {
  const issue = published.find(item => item.id === id && item.status !== 'diarsipkan');
  return issue ? [issue] : [];
});
const featured = active.find(issue => issue.id === order.featured_issue_id) || active[0];
const others = active.filter(issue => issue.id !== featured?.id).slice(0, 2);
const register = [...active, ...published.filter(issue => !active.some(item => item.id === issue.id))];
const categories = [...new Set(register.map(issue => issue.category))];
const updates = [...active].sort((a, b) => b.updated_at.localeCompare(a.updated_at)).slice(0, Math.min(order.max_updates, 5));
const codeFor = (issue: (typeof issues)[number]) => (registerMap as Record<string, string>)[issue.id] || 'PP-???';
function sourceCountFor(issue: (typeof issues)[number]) {
  return new Set([
    ...issue.source_ids,
    ...issue.impact.flatMap(impact => impact.source_ids),
    ...events.filter(event => event.issue_id === issue.id).flatMap(event => event.source_ids),
    ...corrections.filter(change => change.affected_ids.includes(issue.id)).flatMap(change => change.source_ids),
  ]).size;
}
const previewIndicator = indicators.find(indicator => indicator.id === 'pdb-growth')!;
const previewComp = comparisonFor(previewIndicator as any, administrations as any, observations as any, 'admin-2004-2014', 'admin-2014-2024');
---
<Base title="Pahami isu. Periksa buktinya." description="Penjelasan isu politik Indonesia, kronologi, sumber, dan pembanding indikator nasional." canonicalPath="/">
  <header class="home-intro">
    <h1>Pahami isu. Periksa buktinya.</h1>
    <p class="lead">Konteks isu, kronologi bersumber, dan data pembanding.</p>
    <p><span class="stamp" role="note">DRAF PRATINJAU — BELUM AUDIT</span></p>
  </header>

  <div id="issueGrid">
    {featured && <section class="issue-grid" aria-label="Penjelasan pilihan">
      <IssueRegisterEntry issue={featured} code={codeFor(featured)} sourceCount={sourceCountFor(featured)} featured />
      {others.length > 0 && <div class="supporting-issues">
        {others.map(issue => <IssueRegisterEntry issue={issue} code={codeFor(issue)} sourceCount={sourceCountFor(issue)} />)}
      </div>}
    </section>}

    <section aria-labelledby="isu">
      <div class="register-head">
        <h2 id="isu">Register isu</h2>
        <p class="meta" id="resultCount" role="status" aria-atomic="true">{register.length} isu · {categories.length} topik</p>
      </div>
      {register.length > 0 ? <>
        <div class="search-row" id="issueFilterControls" hidden>
          <div class="search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <label class="sr-only" for="issueSearch">Cari nomor, isu, atau topik</label>
            <input id="issueSearch" type="search" name="cari" placeholder="Cari nomor, isu, atau topik" autocomplete="off" disabled />
          </div>
          <ul class="filter-chips" id="categoryFilters" aria-label="Saring menurut topik">
            <li><button type="button" data-category="" aria-pressed="true" disabled>Semua</button></li>
            {categories.map(category => <li><button type="button" data-category={category} aria-pressed="false" disabled>{category}</button></li>)}
          </ul>
          <p><button type="button" class="button--text" id="resetFilter" hidden disabled>Atur ulang filter</button></p>
        </div>
        <p class="meta" id="filterFallback">Seluruh register ditampilkan. Pencarian dan filter memerlukan JavaScript.</p>
        <ol class="register-index" aria-label="Indeks berkas isu">
          {register.map(issue => <IssueIndexEntry issue={issue} code={codeFor(issue)} sourceCount={sourceCountFor(issue)} />)}
        </ol>
        <p class="notice" id="noResults" hidden>Tidak ada isu yang cocok. Coba kata kunci atau topik lain, atau atur ulang filter.</p>
        <details class="mode-help"><summary>Apa arti status isu?</summary><p>Status menjelaskan proses informasi/kebijakan, bukan opini situs: <strong>sedang berkembang</strong> masih berubah dan diperiksa berkala; <strong>menunggu keputusan</strong> menunggu lembaga berwenang; <strong>diterapkan</strong> kebijakan/metode sudah berjalan (bukan penilaian berhasil).</p></details>
      </> : <p>Belum ada isu yang diterbitkan. Penjelasan akan muncul setelah pemeriksaan editorial. <a href="/editorial/">Baca proses editorial.</a></p>}
      <p class="trust-strip"><a href="/metode/">Metode dan batas data</a><a href="/editorial/">Proses editorial</a><a href="/koreksi/">Catatan koreksi</a></p>
    </section>
  </div>

  <section class="section-block" aria-labelledby="bandingkan-heading">
    <div class="section-heading"><h2 id="bandingkan-heading">Bandingkan data</h2></div>
    <p class="preview-caption">Satu indikator, dua periode. Grafik, tabel, sumber, dan metode dalam satu layar.</p>
    <ComparisonPreview comparison={previewComp} indicator={previewIndicator} />
  </section>

  <UpdateLedger items={
    [...corrections.filter(change => change.affected_ids.some(id => active.some(issue => issue.id === id))).map(change => {
      const issue = active.find(item => change.affected_ids.includes(item.id));
      return { kind: 'Koreksi', date: change.corrected_at, title: change.change_summary, href: issue ? `/isu/${issue.slug}/#koreksi` : '/koreksi/', detail: `Alasan: ${change.reason}.` };
    }),
    ...updates.map(issue => ({ kind: 'Penjelasan', date: issue.updated_at, title: issue.title, href: `/isu/${issue.slug}/`, detail: `Status: ${issue.status}.` }))]
      .sort((a, b) => b.date.localeCompare(a.date))
  } />
</Base>
<script>
  import { initIssueFilter } from '../client/home-filter.mjs';
  initIssueFilter(document, window);
</script>
